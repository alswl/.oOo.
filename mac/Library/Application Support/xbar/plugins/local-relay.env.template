# local-relay environment configuration (all keys optional)
# Copy this file to local-relay.env (gitignored) and adjust
# cp local-relay.env.template local-relay.env

# Start the forward automatically on each menu refresh
# (60s cooldown between attempts); a manual Stop pauses it. Default false.
#AUTO_START=true

# Defaults keep the historical 1234 -> 1235 contract; change only if the
# upstream moved.
#GOST_LISTEN=127.0.0.1:1234
#GOST_FORWARD=127.0.0.1:1235
