#!/bin/bash

set -e

OUTPUT_DIR=./.output

mkdir -p "$OUTPUT_DIR"
find "$OUTPUT_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
touch "$OUTPUT_DIR/.gitkeep"
cp .lark.yml "$OUTPUT_DIR/lark.yml"

while IFS= read -r -d '' file_name; do
  new_file_name="$OUTPUT_DIR/${file_name#./}"
  mkdir -p "$(dirname "$new_file_name")"
  pandoc -f markdown -t markdown_github --wrap=none <"$file_name" >"$new_file_name" 2>/dev/null
  printf '\n\n<!-- vim: set ft=markdown.gfm: -->\n' >>"$new_file_name"
done < <(find . -path "./$OUTPUT_DIR" -prune -o -type f -name '*.md' -print0)

while IFS= read -r -d '' assets_dir; do
  rsync -q -avr -- "$assets_dir/" "$OUTPUT_DIR/${assets_dir#./}/"
done < <(find . -path "./$OUTPUT_DIR" -prune -o -type d -name '*.assets' -print0)

generate-output-summary-md
