#!/usr/bin/env bash

# create a new git worktree under .claude/worktrees, named by 3 random words

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

name="$(shuf -n 200 /usr/share/dict/words | grep -E '^[a-z]{3,9}$' | head -n 3 | paste -sd- -)"
[[ -n "$name" ]] || {
    echo "git-worktree-new: cannot build a name from /usr/share/dict/words" >&2
    exit 1
}

git worktree add -b "$name" ".claude/worktrees/$name" || exit 1

# attach initialized submodules as detached worktrees sharing the submodule's git dir
wt="$root/.claude/worktrees/$name"
if [[ -f "$wt/.gitmodules" ]]; then
    while IFS= read -r sub; do
        [[ -z "$sub" ]] && continue
        if [[ -e "$wt/$sub/.git" ]]; then
            git -C "$wt" submodule update --init --recursive -- "$sub" || exit 1
        elif [[ -e "$root/$sub/.git" ]]; then
            commit="$(git -C "$wt" rev-parse "HEAD:$sub")" || exit 1
            mkdir -p "$wt/$(dirname "$sub")" || exit 1
            git -C "$root/$sub" worktree add --detach "$wt/$sub" "$commit" || exit 1
            git -C "$wt/$sub" submodule update --init --recursive || exit 1
        else
            git -C "$wt" submodule update --init --recursive -- "$sub" || exit 1
        fi
    done < <(git config -f "$wt/.gitmodules" --get-regexp '^submodule\..*\.path$' | sed 's/^[^[:space:]]*[[:space:]]//')
fi

# Lockfiles identify uv projects without assuming their directory names.
if ! (
    set -o pipefail
    git -C "$wt" ls-files --recurse-submodules -z -- 'uv.lock' '**/uv.lock' |
        while IFS= read -r -d '' lock; do
            project="$wt/$(dirname "$lock")"
            [[ -f "$project/pyproject.toml" ]] || continue
            if ! command -v uv >/dev/null 2>&1; then
                printf 'git-worktree-new: uv is required to initialize %s\n' "$project" >&2
                exit 1
            fi
            if ! UV_PROJECT_ENVIRONMENT="$project/.venv" uv sync --locked --no-dev --project "$project" >&2; then
                printf 'Retry: UV_PROJECT_ENVIRONMENT=%q uv sync --locked --no-dev --project %q\n' "$project/.venv" "$project" >&2
                exit 1
            fi
        done
); then
    printf 'git-worktree-new: uv initialization failed; worktree retained at %s\n' "$wt" >&2
    exit 1
fi

echo "created: $wt"
