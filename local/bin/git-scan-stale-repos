#!/usr/bin/env python3
"""Find clean repositories matching locally cached origin branches. Output JSON."""
import argparse, os, subprocess, concurrent.futures, datetime, json
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('root', nargs='?', default=os.getcwd(), help='directory to scan (default: current directory)')
parser.add_argument('--days', type=int, default=365, help='minimum days since last recorded fetch/pull (default: 365)')
parser.add_argument('--workers', type=int, default=12, help='parallel workers (default: 12)')
args = parser.parse_args()
if args.days < 0 or args.workers < 1: parser.error('--days must be nonnegative and --workers must be positive')
root=os.path.abspath(args.root)
if not os.path.isdir(root): parser.error('root must be an existing directory')
cutoff=(datetime.datetime.now().astimezone()-datetime.timedelta(days=args.days)).timestamp()
repos=[]
for base, dirs, files in os.walk(root):
    dirs[:]=[d for d in dirs if d not in ('.git','node_modules','target','dist','.venv')]
    if '.git' in files or os.path.isdir(os.path.join(base,'.git')): repos.append(base)
def git(p,*args,optional=False):
    result=subprocess.run(['git','-C',p,*args],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,timeout=30)
    if result.returncode and not optional: raise RuntimeError('git '+ ' '.join(args) + ': ' + result.stderr.strip())
    return result.stdout.strip()
def check(p):
 try:
    url=git(p,'remote','get-url','origin',optional=True)
    if not url:return {'reason':'no_origin'}
    status=git(p,'status','--porcelain=v1','--untracked-files=all')
    if status:return {'reason':'dirty'}
    branch=git(p,'symbolic-ref','--quiet','--short','HEAD',optional=True)
    up=git(p,'rev-parse','--abbrev-ref','--symbolic-full-name','@{upstream}',optional=True)
    if not branch or not up.startswith('origin/'):return {'reason':'no_origin_upstream'}
    head=git(p,'rev-parse','HEAD'); remote=git(p,'rev-parse',up)
    if head!=remote:return {'reason':'head_differs'}
    refs=git(p,'for-each-ref','--format=%(refname:short) %(objectname)','refs/heads').splitlines()
    # Local branches must have a matching origin branch at the same commit.
    rem=dict(line.split(' ',1) for line in git(p,'for-each-ref','--format=%(refname:short) %(objectname)','refs/remotes/origin').splitlines() if ' ' in line)
    for line in refs:
      name,sha=line.split(' ',1)
      if rem.get('origin/'+name)!=sha:return {'reason':'local_branches_differ'}
    wt=git(p,'worktree','list','--porcelain').count('worktree ')
    if wt>1:return {'reason':'multiple_worktrees'}
    common=git(p,'rev-parse','--git-common-dir'); common=os.path.abspath(os.path.join(p,common))
    fetch=os.path.join(common,'FETCH_HEAD')
    ft=os.path.getmtime(fetch) if os.path.exists(fetch) else None
    # Reflogs retain explicit pull activity when not expired.
    logs=git(p,'reflog','show','--all','--format=%ct%x09%gs').splitlines()
    pulls=[int(x.split('\t',1)[0]) for x in logs if '\t' in x and ('pull' in x.split('\t',1)[1].lower()) and x.split('\t',1)[0].isdigit()]
    last=max(([ft] if ft else [])+pulls,default=None)
    if last and last>=cutoff:return {'reason':'recent_fetch_or_pull'}
    return {'reason':'candidate','path':os.path.relpath(p,root),'url':url,'branch':branch,'last':datetime.datetime.fromtimestamp(last).strftime('%Y-%m-%d') if last else None,'fetch':bool(ft)}
 except Exception as e:return {'reason':'error','path':os.path.relpath(p,root),'error':str(e)}
with concurrent.futures.ThreadPoolExecutor(max_workers=args.workers) as pool: results=list(pool.map(check,repos))
from collections import Counter
print(json.dumps({'root':root,'days':args.days,'scanned_at':datetime.datetime.now().astimezone().isoformat(),'total':len(repos),'counts':dict(Counter(x['reason'] for x in results)),'candidates':[x for x in results if x['reason']=='candidate'],'errors':[x for x in results if x['reason']=='error']},ensure_ascii=False,indent=2))
