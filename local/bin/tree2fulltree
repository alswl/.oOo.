#!/usr/bin/env python3
# coding=utf-8
"""
convert `tree` command output to file path output
"""

from __future__ import unicode_literals, absolute_import, print_function

import re
import sys
from urllib.parse import quote_from_bytes

REGEX_MATCH = r'((?:[| ]?   )*)[|`]-- \[.+]\  (.+)'


def main():
    last_level = 0
    parents = []
    last_name = None
    endpoint = None

    for line in sys.stdin.buffer:
        line = line.decode('utf-8')
        if endpoint is None:
            endpoint = line.strip()

        match = re.match(REGEX_MATCH, line)
        if not match:
            continue
        if len(match.groups()) != 2:
            continue

        level = len((match.groups()[0] or '')) // 4
        name = match.groups()[1]
        if level > last_level:
            parents.append(last_name)
        elif level < last_level:
            parents = parents[:level]

        output = endpoint + '/' + '/'.join(parents + [name]) + '\n'
        output += '    => ' + endpoint + '/' + '/'.join(
            [quote_from_bytes(x.encode('gbk')) for x in parents + [name]]) + '\n'
        print(output, end='')

        last_name = name
        last_level = level
    sys.stdout.flush()


if __name__ == '__main__':
    try:
        main()
    except IOError:
        pass

